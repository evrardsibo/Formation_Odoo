<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="0">
        <record id="training_security" model="ir.module.category">
            <field name="name">Training</field>
            <field name="description">Training Groups</field>
        </record>

        <record id="manager_group" model="res.groups">
            <field name="name">Administrator Training</field>
            <field name="category_id" ref="training_security"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="supervisor_group" model="res.groups">
            <field name="name">Supervisor</field>
            <field name="category_id" ref="training_security"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="participant_group" model="res.groups">
            <field name="name">Participant</field>
            <field name="category_id" ref="training_security"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>


        <record id="user_rule_supervisor" model="ir.rule">
            <field name="name">Supervisor Rule</field>
            <field name="model_id" ref="model_training"/>
            <field name="domain_force">[('supervisor_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('supervisor_group'))]"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_unlink" eval="0"/>
            <field name="perm_read" eval="1"/>
        </record>

        <record id="participant_rule" model="ir.rule">
            <field name="name">Participant Rule</field>
            <field name="model_id" ref="model_training"/>
            <field name="domain_force">[('line_ids.employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('participant_group'))]"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_unlink" eval="0"/>
            <field name="perm_read" eval="1"/>
        </record>

        <record id="participant_rules" model="ir.rule">
            <field name="name">Participant Rule</field>
            <field name="model_id" ref="model_training_line"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('participant_group'))]"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_unlink" eval="0"/>
            <field name="perm_read" eval="1"/>
        </record>

    </data>
</odoo>