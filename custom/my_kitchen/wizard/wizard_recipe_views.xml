<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="wizard_recipe_form" model="ir.ui.view">
            <field name="name">Wizards.form</field>
            <field name="model">recipe.wizard</field>
            <field name="arch" type="xml">
                <form string="Tag">
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                        <field name="cooking_time"/>
                        <field name="serving_size"/>

                    </group>
                    <footer>
                        <button name="create_record_recipe" string="Confirm" type="object" class="btn btn-success"/>
                        <button special="cancel" string="Cancel" type="object" class="btn btn-danger"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>